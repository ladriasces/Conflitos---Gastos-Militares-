# Dados brutos: grandes (~270 MB) e baixados de novo por `python -m src.download`.
# O manifesto fica versionado porque registra URL, versão e data de acesso de cada base.
data/raw/*
!data/raw/_manifesto.json

__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
desktop.ini
.DS_Store

# Ficam só na pasta local: versões de divulgação das figuras e textos de trabalho.
# O código continua gerando todas; no repositório fica a versão 16:9 de cada figura.
outputs/figures/*_instagram.png
outputs/figures/*.svg
outputs/texto/
